# VendorBooks environment
# Copy to .env.local for Next.js. Never commit real secrets.
# With nothing filled in, `npm run dev` runs in demo mode (sample antique mall).

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = always use the local demo ledger, even if Supabase keys are present.
# false = require Supabase. Leave unset to demo locally and use Supabase when keys exist.
DEMO_MODE=
# Secret for demo-session cookies and OAuth state HMAC. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=

# 32-byte key, base64 or base64url. Encrypts Square tokens at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Comma-separated emails that become platform admins (the "Mark" view) on signup.
PLATFORM_ADMIN_EMAILS=mark@example.com

# Optional analytics. When set, a Plausible script is added to marketing pages.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Protects /api/cron/* . Vercel Cron sends Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# ---- Supabase ----
# Project URL and anon key are safe in the browser. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Square ----
# sandbox uses connect.squareupsandbox.com. production uses connect.squareup.com.
SQUARE_ENV=sandbox
SQUARE_API_VERSION=2026-01-22
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# Must match the redirect URL saved on the Square application, exactly.
SQUARE_OAUTH_REDIRECT_URL=http://localhost:3000/api/square/oauth/callback
# Webhook signature key from the Square developer console (Sandbox and Production differ).
SQUARE_WEBHOOK_SIGNATURE_KEY=
# The exact notification URL Square signs. Must match the subscription URL, including https.
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:3000/api/square/webhook

# Optional separate production credentials. When SQUARE_ENV=production these are used if set.
SQUARE_PRODUCTION_APPLICATION_ID=
SQUARE_PRODUCTION_APPLICATION_SECRET=
SQUARE_PRODUCTION_WEBHOOK_SIGNATURE_KEY=
SQUARE_PRODUCTION_WEBHOOK_NOTIFICATION_URL=

# ---- Stripe Billing ----
# Annual prices must be 10x the monthly price (2 months free). Amounts in cents:
# Shop $49/mo or $490/yr. Mall $129/mo or $1,290/yr. Trial is 14 days, set on the Checkout Session.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_SHOP_MONTHLY=
STRIPE_PRICE_SHOP_ANNUAL=
STRIPE_PRICE_MALL_MONTHLY=
STRIPE_PRICE_MALL_ANNUAL=

# ---- Resend ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=statements@yourdomain.com
